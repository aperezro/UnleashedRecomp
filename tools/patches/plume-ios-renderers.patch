 namespace plume {
+#if PLUME_IOS
+    static std::mutex submissionMutex;
+    static std::condition_variable submissionCondition;
+    static bool applicationActive = true;
+    static std::unordered_map<MTL::CommandQueue *, MTL::CommandBuffer *> pendingSubmissions;
+
+    static std::unique_lock<std::mutex> lockSubmissions() {
+        std::unique_lock lock(submissionMutex);
+        while (!applicationActive) {
+            if (pthread_main_np()) {
+                // The installer renders on the UIKit thread. Keep activation
+                // notifications deliverable while a submission is suspended.
+                lock.unlock();
+                CFRunLoopRunInMode(kCFRunLoopDefaultMode, 0.01, true);
+                lock.lock();
+            }
+            else {
+                submissionCondition.wait(lock);
+            }
+        }
+        return lock;
+    }
+
+    // Called under submissionMutex; keep only the tail of each ordered queue.
+    static void trackSubmission(MTL::CommandQueue *queue, MTL::CommandBuffer *buffer) {
+        auto &previous = pendingSubmissions[queue];
+        if (previous != nullptr) {
+            previous->release();
+        }
+        previous = buffer->retain();
+    }
+
+    void setMetalApplicationActive(bool active) {
+        {
+            std::lock_guard lock(submissionMutex);
+            if (applicationActive == active) {
+                return;
+            }
+            applicationActive = active;
+            if (!active) {
+                // iOS may suspend us as soon as its lifecycle callback returns.
+                // Draining scheduling here also prevents lost event signals from
+                // rejected background buffers poisoning all subsequent frames.
+                for (auto &[queue, buffer] : pendingSubmissions) {
+                    buffer->waitUntilScheduled();
+                    buffer->release();
+                }
+                pendingSubmissions.clear();
+            }
+            fprintf(stderr, "Metal lifecycle: %s\n", active ? "resumed" : "suspended (submissions scheduled)");
+        }
+        if (active) {
+            submissionCondition.notify_all();
+        }
+    }
+#endif
